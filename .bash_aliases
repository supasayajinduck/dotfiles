#### Prompt Dynamique Type Entreprise (Alerte RedRoot) ##################################################################
    # Si ROOT : Utilisateur en Rouge Flashy, symbole '#' à la fin
    PS1='\[\033[01;31m\]\u\[\033[00m\]@\[\033[01;32m\]\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[01;31m\]#\[\033[00m\] '
else
    # Si Utilisateur normal : Cyan et Vert, symbole '$' à la fin
    PS1='\[\033[01;36m\]\u\[\033[00m\]@\[\033[01;32m\]\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
fi
